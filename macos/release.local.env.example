# Upload accounts for the macOS releases.
#
# Copy this file to  macos/release.local.env  (that name is git-ignored - it never gets
# committed), fill in what Gabor gave you, then:  chmod 600 macos/release.local.env
#
# Each account is an extra FTP user whose home folder is the macos/ folder of that site - it can
# publish macOS builds and cannot touch anything else. The server offers FTP over TLS.

# ---------------------------------------------------------------- PRIMARY (required)
# https://claudeusagemonitor.com/macos/  - the home of the project. From now on this is the one
# that matters; everything else is transitional.
UM_FTP_HOST="claudeusagemonitor.com"
UM_FTP_USER=""
UM_FTP_PASS=""
# Folder below the account's home. Leave empty when the account's home already IS the macos folder.
UM_FTP_DIR=""

# ---------------------------------------------------------------- LEGACY (optional, temporary)
# Only so macOS copies installed BEFORE the move keep receiving updates: they still ask the old
# address for their manifest. Its manifest points the download at the old host on purpose.
#
# Leave all four empty (or delete this block) to publish only to the primary site - that is the
# normal state once the old installs have moved over.
UM_LEGACY_BASE_URL="https://dinorr.hu/claude-usage-monitor/"
UM_LEGACY_FTP_HOST="dinorr.hu"
UM_LEGACY_FTP_USER=""
UM_LEGACY_FTP_PASS=""
UM_LEGACY_FTP_DIR=""
