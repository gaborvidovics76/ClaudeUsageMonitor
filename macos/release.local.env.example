# Upload account for the macOS releases.
# Copy this file to  macos/release.local.env  (that name is git-ignored - it never gets committed),
# fill in what Gabor gave you, then:  chmod 600 macos/release.local.env
#
# The account is an extra FTP user whose home folder is the server's  claude-usage-monitor/macos
# folder - so it can publish macOS builds and cannot touch anything else.

CUM_FTP_HOST="dinorr.hu"
CUM_FTP_USER=""
CUM_FTP_PASS=""

# Folder below the account's home. Leave empty when the account's home already IS the macos folder.
CUM_FTP_DIR=""
