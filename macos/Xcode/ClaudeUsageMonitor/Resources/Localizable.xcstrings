        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、サーバーがメッセージを受け付けられません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 서버가 메시지를 받을 수 없어요. 나중에 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris šiuo metu negali priimti žinutės. Bandykite vėliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris pašlaik nevarēja pieņemt ziņu. Lūdzu, mēģiniet vēlāk."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-server ma setax jilqa' l-messaġġ bħalissa. Jekk jogħġbok erġa' pprova aktar tard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server kan het bericht op dit moment niet ontvangen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie może teraz przyjąć wiadomości. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu receber a mensagem agora. Tente de novo mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento, o servidor não conseguiu receber a mensagem. Tenta de novo mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu a putut primi mesajul acum. Încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер сейчас не может принять сообщение. Попробуйте позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server momentálne nemôže správu prijať. Skús to neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnik trenutno ne more sprejeti sporočila. Poskusite znova pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern kunde inte ta emot meddelandet just nu. Försök igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu mesajı şu anda alamadı. Lütfen daha sonra yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ hiện chưa thể nhận tin nhắn. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器暂时无法接收留言。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器目前無法接收訊息，請稍後再試。"
          }
        }
      }
    },
    "fb.intro": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Идея, грешка или просто ти харесва? Пиши ми. Всяко съобщение чета лично аз – Vidovics Gábor, авторът на програмата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nápad, chyba, nebo se vám program prostě líbí? Napište mi. Každou zprávu čtu osobně – Vidovics Gábor, autor programu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En idé, en fejl, eller kan du bare godt lide det? Skriv til mig. Hver eneste besked læses af mig, Vidovics Gábor, programmets udvikler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Idee, ein Fehler – oder gefällt dir das Programm einfach? Schreib mir. Ich lese jede Nachricht selbst – Vidovics Gábor, der Autor des Programms."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ιδέα, ένα σφάλμα ή απλώς σας αρέσει; Πείτε μου. Κάθε μήνυμα το διαβάζω εγώ, ο Vidovics Gábor, ο δημιουργός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An idea, a bug, or you simply like it? Tell me. Every message is read by me, Vidovics Gábor, the author."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Una idea, un fallo o simplemente te gusta? Cuéntamelo. Todos los mensajes los leo yo, Vidovics Gábor, el autor."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Una idea, un error o simplemente te gusta? Cuéntame. Cada mensaje lo leo yo, Vidovics Gábor, el autor del programa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul on idee, leidsid vea või programm lihtsalt meeldib? Kirjuta mulle. Iga sõnumi loen läbi mina ise, Vidovics Gábor, programmi autor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Idea, virhe vai pidätkö vain ohjelmasta? Kerro minulle. Luen jokaisen viestin itse – Vidovics Gábor, ohjelman tekijä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une idée, un bug, ou l'application vous plaît tout simplement ? Écrivez-moi. Je lis personnellement chaque message – Vidovics Gábor, l'auteur du programme."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An bhfuil smaoineamh agat, ar aimsigh tú fabht, nó an maith leat an clár, sin an méid? Inis dom. Léim féin gach teachtaireacht – mise Vidovics Gábor, údar an chláir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imate ideju, pronašli ste pogrešku ili vam se program jednostavno sviđa? Javite mi. Svaku poruku čitam osobno – Vidovics Gábor, autor programa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötlet, hiba, vagy egyszerűen tetszik? Írd meg. Minden üzenetet én olvasok el, Vidovics Gábor, a program készítője."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Punya ide, menemukan bug, atau sekadar menyukainya? Sampaikan kepada saya. Setiap pesan saya baca sendiri – Vidovics Gábor, pembuat program ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'idea, un bug o semplicemente il programma ti piace? Scrivimi. Leggo personalmente ogni messaggio: sono Vidovics Gábor, l'autore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデアや不具合の報告、あるいは「気に入った」のひと言でも、ぜひお聞かせください。メッセージはすべて、作者である私 Vidovics Gábor が自分で読んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어나 버그가 있나요, 아니면 그냥 마음에 드나요? 알려 주세요. 모든 메시지는 제작자인 저, Vidovics Gábor가 직접 읽어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Turite idėją, radote klaidą ar programa tiesiog patinka? Parašykite. Kiekvieną žinutę skaitau aš pats – Vidovics Gábor, programos autorius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideja, kļūda vai vienkārši patīk? Uzrakstiet man. Katru ziņu izlasu es pats – Vidovics Gábor, programmas autors."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għandek idea, sibt bug, jew sempliċement jogħġbok? Għidli. Kull messaġġ naqrah jien, Vidovics Gábor, l-awtur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een idee, een bug, of vind je het programma gewoon fijn? Laat het me weten. Ik lees elk bericht zelf – Vidovics Gábor, de maker van het programma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomysł, błąd, a może program po prostu Ci się podoba? Napisz do mnie. Każdą wiadomość czytam osobiście – Vidovics Gábor, autor programu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem uma ideia, achou um bug ou simplesmente gostou? Me conte. Eu, Vidovics Gábor, o autor, leio todas as mensagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ideia, um erro ou simplesmente gostas? Diz-me. Leio pessoalmente todas as mensagens – Vidovics Gábor, o autor do programa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai o idee, ai găsit o eroare sau pur și simplu îți place programul? Spune-mi. Citesc personal fiecare mesaj – sunt Vidovics Gábor, autorul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть идея, нашли ошибку или программа просто нравится? Напишите мне. Каждое сообщение я читаю сам – Vidovics Gábor, автор программы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nápad, chyba alebo sa ti to jednoducho páči? Napíš mi. Každú správu čítam ja, Vidovics Gábor, autor programu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imate idejo, ste našli napako ali vam je program preprosto všeč? Povejte mi. Vsako sporočilo preberem sam – Vidovics Gábor, avtor programa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du en idé, har du hittat en bugg eller gillar du bara programmet? Berätta! Jag, Vidovics Gábor, som har utvecklat det, läser varje meddelande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fikriniz mi var, bir hata mı buldunuz, yoksa programı sadece beğendiniz mi? Bana yazın. Her mesajı bizzat ben okuyorum – Vidovics Gábor, programın yazarı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có ý tưởng, phát hiện lỗi, hay đơn giản là thấy thích? Hãy cho tôi biết. Tôi, Vidovics Gábor – tác giả – tự mình đọc mọi tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有想法、发现了问题，或者只是喜欢这个程序？告诉我吧。每一条留言都由我——作者 Vidovics Gábor——亲自阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有想法、發現了錯誤，或者只是喜歡這個程式？告訴我吧。每一則訊息都由作者 Vidovics Gábor（也就是我）親自閱讀。"
          }
        }
      }
    },
