    "set.rows_available": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво може да се покаже в момента – махни отметката от това, което не искаш да виждаш:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co lze nyní zobrazit – odškrtněte, co nechcete vidět:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad der kan vises lige nu – fjern fluebenet ved det, du ikke vil se:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was aktuell angezeigt werden kann – Haken entfernen, um es auszublenden:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι μπορεί να εμφανιστεί αυτήν τη στιγμή – καταργήστε την επιλογή όσων δεν θέλετε να βλέπετε:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be shown right now – untick what you do not want to see:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede mostrar ahora mismo (desmarca lo que no quieras ver):"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede mostrar ahora (desmarca lo que no quieras ver):"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida saab praegu kuvada – eemalda linnuke sellelt, mida sa näha ei soovi:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä voidaan näyttää juuri nyt – poista valinta niistä, joita et halua nähdä:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui peut être affiché actuellement – décochez ce que vous ne voulez pas voir :"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cad is féidir a thaispeáint anois – bain an tic de na rudaí nach dteastaíonn uait a fheiceáil:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što se trenutačno može prikazati – poništite odabir onoga što ne želite vidjeti:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ami most megjeleníthető – vedd ki a pipát abból, amit nem akarsz látni:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dapat ditampilkan saat ini – hapus centang yang tidak ingin Anda lihat:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che si può mostrare ora – deseleziona ciò che non vuoi vedere:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示できる項目です。表示しない項目はチェックを外してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 표시할 수 있는 항목이에요 – 보고 싶지 않은 항목은 선택을 해제하세요:"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką galima rodyti dabar – nuimkite žymę nuo to, ko nenorite matyti:"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko pašlaik var parādīt – noņemiet atzīmi no tā, ko nevēlaties redzēt:"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "X'jista' jintwera issa – neħħi l-marka minn dak li ma tridx tara:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat nu getoond kan worden – vink uit wat je niet wilt zien:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co można teraz pokazać – odznacz to, czego nie chcesz widzieć:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser mostrado agora – desmarque o que você não quer ver:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser mostrado agora – desmarca o que não queres ver:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce se poate afișa acum – debifează ce nu vrei să vezi:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что сейчас можно показать – снимите галочку с ненужного:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo sa dá práve zobraziť – zruš začiarknutie pri tom, čo nechceš vidieť:"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj je mogoče prikazati zdaj – odstranite kljukico pri tistem, česar ne želite videti:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kan visas just nu – avmarkera det du inte vill se:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda gösterilebilecekler – görmek istemediklerinizin işaretini kaldırın:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì có thể hiển thị ngay bây giờ – bỏ chọn mục bạn không muốn thấy:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可显示的项目——取消勾选你不想看到的："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前可顯示的內容，請取消勾選你不想看到的："
          }
        }
      }
    },
    "set.rows_none": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В момента сървърът не изпраща допълнителни лимити за акаунта ти. Щом започне, те ще се появят тук автоматично."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nyní pro váš účet žádné další limity neposílá. Jakmile začne, objeví se zde samy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren sender ingen yderligere grænser for din konto lige nu. De dukker op her af sig selv, så snart den gør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server sendet derzeit keine weiteren Limits für dein Konto. Sobald er es tut, erscheinen sie hier von selbst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν στέλνει προς το παρόν άλλα όρια για τον λογαριασμό σας. Θα εμφανιστούν εδώ αυτόματα μόλις το κάνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sends no further limits for your account at the moment. They appear here by themselves as soon as it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo el servidor no envía más límites para tu cuenta. Aparecerán aquí por sí solos en cuanto lo haga."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora el servidor no envía más límites para tu cuenta. Aparecerán aquí automáticamente en cuanto lo haga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ei saada praegu sinu konto kohta rohkem limiite. Niipea kui saadab, ilmuvad need siia automaatselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei tällä hetkellä lähetä tilillesi muita rajoja. Ne tulevat tähän näkyviin itsestään heti, kun palvelin lähettää niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'envoie actuellement aucune autre limite pour votre compte. Elles apparaîtront ici d'elles-mêmes."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní sheolann an freastalaí aon teorainneacha eile do do chuntas faoi láthair. Taispeánfar anseo iad leo féin a luaithe a sheolann sé iad."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj trenutačno ne šalje dodatna ograničenja za vaš račun. Čim ih pošalje, automatski će se pojaviti ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver jelenleg nem küld további limitet a fiókodhoz. Amint küld, magától megjelenik itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini server tidak mengirim batas lain untuk akun Anda. Batas tersebut akan muncul di sini secara otomatis begitu dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento il server non invia altri limiti per il tuo account. Compariranno qui da soli non appena lo farà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、サーバーはこのアカウントに追加の上限を送信していません。送信され次第、ここに自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 서버가 이 계정에 추가 한도를 보내지 않아요. 보내기 시작하면 여기에 자동으로 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu serveris jūsų paskyrai daugiau limitų nesiunčia. Kai tik atsiųs, jie čia atsiras patys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris pašlaik nesūta citus limitus jūsu kontam. Tiklīdz tas notiks, tie automātiski parādīsies šeit."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bħalissa s-server ma jibgħat l-ebda limitu ieħor għall-kont tiegħek. Jidhru hawn waħedhom hekk kif jibgħathom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server stuurt op dit moment geen verdere limieten voor je account. Ze verschijnen hier vanzelf zodra dat gebeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie wysyła obecnie dalszych limitów dla twojego konta. Pojawią się tu same, gdy tylko zacznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento, o servidor não envia outros limites para a sua conta. Eles aparecem aqui automaticamente assim que forem enviados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento, o servidor não envia mais limites para a tua conta. Assim que o fizer, aparecem aqui automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan serverul nu trimite alte limite pentru contul tău. Vor apărea aici automat de îndată ce o va face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас сервер не отправляет других лимитов для вашего аккаунта. Они появятся здесь сами, как только начнёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server momentálne neposiela pre tvoj účet žiadne ďalšie limity. Hneď ako ich začne posielať, zobrazia sa tu automaticky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnik trenutno ne pošilja dodatnih omejitev za vaš račun. Ko jih bo začel pošiljati, se bodo tukaj prikazale samodejno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern skickar just nu inga fler gränser för ditt konto. De visas här automatiskt så fort den gör det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu şu anda hesabınız için başka limit göndermiyor. Gönderdiğinde burada kendiliğinden görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện máy chủ không gửi thêm giới hạn nào cho tài khoản của bạn. Khi có, chúng sẽ tự xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器目前没有为你的账户提供其他限额。一旦提供，会自动显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器目前未為你的帳戶傳送其他上限。一旦傳送，就會自動顯示在這裡。"
          }
        }
      }
    },
