    "set.datafile_hint_mac": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS führt diese App in einer Sandbox aus: Wähle einmal das Nutzungsprotokoll von Claude Desktop (Library → Application Support → Claude → plan-usage-history.json), damit die App es lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS keeps this app in a sandbox: choose Claude Desktop's usage log once (Library → Application Support → Claude → plan-usage-history.json), so the app may read it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exécute cette app dans un bac à sable : choisissez une fois le journal d'utilisation de Claude Desktop (Library → Application Support → Claude → plan-usage-history.json) pour que l'app puisse le lire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS homokozóban futtatja ezt az appot: válaszd ki egyszer a Claude Desktop használati naplóját (Library → Application Support → Claude → plan-usage-history.json), hogy az app olvashassa."
          }
        }
      }
    },
