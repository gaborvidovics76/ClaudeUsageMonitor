    "notify.first_run": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Панелът се появи в горния десен ъгъл.\nДесен бутон върху панела или иконата в лентата с менюта = меню."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel se objevil vpravo nahoře.\nPravé tlačítko na panelu nebo ikoně v řádku nabídek = nabídka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelet er dukket op i øverste højre hjørne.\nHøjreklik på panelet eller ikonet i menulinjen = menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Panel erscheint oben rechts.\nRechtsklick auf das Panel oder das Menüleistensymbol = Menü."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πίνακας εμφανίστηκε στην επάνω δεξιά γωνία.\nΔεξί κλικ στον πίνακα ή στο εικονίδιο της γραμμής μενού = μενού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panel appeared in the top-right corner.\nRight-click the panel or the menu bar icon = menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel ha aparecido en la esquina superior derecha.\nClic derecho en el panel o en el icono de la barra de menús = menú."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel apareció en la esquina superior derecha.\nClic derecho en el panel o en el ícono de la barra de menús = menú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneel ilmus ekraani paremasse ülanurka.\nMenüü avamiseks paremklõpsa paneelil või menüüriba ikoonil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneeli ilmestyi näytön oikeaan yläkulmaan.\nValikko: osoita toissijaisesti paneelia tai valikkorivin kuvaketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau est apparu en haut à droite.\nClic droit sur le panneau ou l'icône de la barre des menus = menu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an painéal sa chúinne uachtarach ar dheis.\nDeaschliceáil ar an bpainéal nó ar dheilbhín an bharra roghchláir = roghchlár."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel se pojavio u gornjem desnom kutu.\nDesni klik na panel ili ikonu na traci izbornika = izbornik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel a képernyő jobb felső sarkában jelent meg.\nJobb gomb a panelen vagy a menüsor ikonján = menü."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel muncul di pojok kanan atas layar.\nKlik kanan panel atau ikon di bar menu = menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello è apparso in alto a destra.\nClic destro sul pannello o sull'icona della barra dei menu = menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルが画面の右上に表示されました。\nパネルまたはメニューバーのアイコンを右クリックすると、メニューが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널이 화면 오른쪽 위에 나타났어요.\n패널이나 메뉴 막대 아이콘을 오른쪽 클릭하면 메뉴가 열려요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skydelis atsirado viršutiniame dešiniajame kampe.\nSpustelėkite skydelį ar meniu juostos piktogramą dešiniuoju pelės mygtuku – atsivers meniu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelis parādījās ekrāna augšējā labajā stūrī.\nLabā poga uz paneļa vai izvēļņu joslas ikonas = izvēlne."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-pannell deher fir-rokna ta' fuq tal-lemin.\nKlikk bil-lemin fuq il-pannell jew fuq l-ikona fil-menu bar = menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het paneel staat rechtsboven.\nRechtsklik op het paneel of het menubalkpictogram = menu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel pojawił się w prawym górnym rogu.\nPrawy przycisk na panelu lub ikonie paska menu = menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel apareceu no canto superior direito da tela.\nBotão direito no painel ou no ícone da barra de menus = menu."
