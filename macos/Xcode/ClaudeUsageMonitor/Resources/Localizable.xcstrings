    "help.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Независим, безплатен инструмент – не е създаден от Anthropic и не е свързан с компанията. „Claude“ е търговска марка на Anthropic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezávislý bezplatný nástroj – nevytvořila ho společnost Anthropic ani s ní není spojen. „Claude“ je ochranná známka Anthropic."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et uafhængigt, gratis værktøj – hverken lavet af eller tilknyttet Anthropic. “Claude” er et varemærke tilhørende Anthropic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unabhängiges, kostenloses Werkzeug – nicht von Anthropic und nicht mit Anthropic verbunden. „Claude“ ist eine Marke von Anthropic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανεξάρτητο, δωρεάν εργαλείο – δεν έχει δημιουργηθεί από την Anthropic ούτε συνδέεται με αυτήν. Το «Claude» είναι εμπορικό σήμα της Anthropic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An independent, free tool – not made by or affiliated with Anthropic. “Claude” is a trademark of Anthropic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herramienta independiente y gratuita: no la ha creado Anthropic ni está vinculada a ella. «Claude» es una marca de Anthropic."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una herramienta independiente y gratuita: no fue creada por Anthropic ni está afiliada a ella. “Claude” es una marca de Anthropic."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõltumatu tasuta tööriist – Anthropic ei ole seda loonud ega sellega seotud. „Claude“ on Anthropicu kaubamärk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Itsenäinen, ilmainen työkalu – Anthropic ei ole tehnyt sitä, eikä se ole sidoksissa Anthropiciin. ”Claude” on Anthropicin tavaramerkki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un outil indépendant et gratuit – ni créé par Anthropic ni affilié à Anthropic. « Claude » est une marque d’Anthropic."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Uirlis neamhspleách saor in aisce – ní de chuid Anthropic í agus níl baint ar bith aici le Anthropic. Is trádmharc de chuid Anthropic é “Claude”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neovisan, besplatan alat – nije proizvod tvrtke Anthropic niti je s njom povezan.„Claude” je zaštitni znak tvrtke Anthropic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Független, ingyenes eszköz – nem az Anthropic készítette, és nem áll kapcsolatban vele. A „Claude” az Anthropic védjegye."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat independen dan gratis – tidak dibuat oleh dan tidak berafiliasi dengan Anthropic. “Claude” adalah merek dagang Anthropic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno strumento indipendente e gratuito – non realizzato da Anthropic né affiliato. «Claude» è un marchio di Anthropic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した無料のツールです。Anthropic が開発したものではなく、Anthropic との提携関係もありません。「Claude」は Anthropic の商標です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic이 만들거나 Anthropic과 제휴한 도구가 아닌, 독립적인 무료 도구예요. “Claude”는 Anthropic의 상표예요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepriklausomas nemokamas įrankis – jo nesukūrė Anthropic ir jis nėra su Anthropic susijęs. „Claude“ yra Anthropic prekių ženklas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neatkarīgs, bezmaksas rīks – to nav izstrādājis Anthropic, un tas nav saistīts ar Anthropic. „Claude” ir Anthropic preču zīme."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għodda indipendenti u b'xejn – mhix magħmula minn Anthropic u m'għandha l-ebda rabta magħha. “Claude” hija marka kummerċjali ta' Anthropic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een onafhankelijk, gratis hulpmiddel – niet gemaakt door of verbonden aan Anthropic. ‘Claude’ is een handelsmerk van Anthropic."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezależne, darmowe narzędzie – nie jest tworzone przez Anthropic ani z nim powiązane. „Claude” jest znakiem towarowym Anthropic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ferramenta independente e gratuita – não foi feita pela Anthropic nem tem vínculo com ela. “Claude” é uma marca registrada da Anthropic."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ferramenta independente e gratuita – não foi criada pela Anthropic nem está associada a ela. «Claude» é uma marca da Anthropic."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instrument independent și gratuit – nu este realizat de Anthropic și nici afiliat cu aceasta. „Claude” este o marcă comercială a Anthropic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Независимый бесплатный инструмент — не создан Anthropic и не связан с ней. «Claude» — товарный знак Anthropic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezávislý bezplatný nástroj – nevytvorila ho spoločnosť Anthropic a nie je s ňou nijako prepojený. „Claude“ je ochranná známka spoločnosti Anthropic."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neodvisno, brezplačno orodje – ni izdelek družbe Anthropic in ni z njo povezano. „Claude“ je blagovna znamka družbe Anthropic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett oberoende, kostnadsfritt verktyg – inte gjort av eller knutet till Anthropic. ”Claude” är ett varumärke som tillhör Anthropic."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız, ücretsiz bir araç – Anthropic tarafından yapılmamıştır ve Anthropic ile bağlantılı değildir. “Claude”, Anthropic’in ticari markasıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một công cụ độc lập, miễn phí – không do Anthropic tạo ra và không liên kết với Anthropic. “Claude” là nhãn hiệu của Anthropic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一款独立的免费工具，并非由 Anthropic 开发，也与其没有任何关联。“Claude”是 Anthropic 的商标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一款獨立的免費工具，並非由 Anthropic 製作，也與 Anthropic 無任何隸屬關係。「Claude」是 Anthropic 的商標。"
          }
        }
      }
    },
    "help.feedback": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въпроси, идеи, съобщения за грешки: формата за контакт на уебсайта."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotazy, nápady, hlášení chyb: formulář pro zprávy na webu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmål, idéer, fejlrapporter: beskedformularen på webstedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen, Ideen, Fehlermeldungen: das Nachrichtenformular auf der Website."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ερωτήσεις, ιδέες, αναφορές σφαλμάτων: η φόρμα μηνύματος στον ιστότοπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, ideas, bug reports: the message form on the website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas, ideas, avisos de fallos: el formulario de mensajes del sitio web."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas, ideas, reportes de errores: el formulario de mensajes del sitio web."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsimused, ideed, veateated: veebisaidi sõnumivorm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysymykset, ideat ja virheilmoitukset: viestilomake verkkosivustolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, idées, signalements de bugs : le formulaire de contact du site."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceisteanna, smaointe, tuairiscí fabhtanna: an fhoirm teachtaireachta ar an suíomh gréasáin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitanja, ideje, prijave pogrešaka: obrazac za poruke na web-stranici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdés, ötlet, hibajelzés: az üzenetküldő űrlap a weboldalon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan, ide, laporan bug: formulir pesan di situs web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande, idee, segnalazioni: il modulo di contatto sul sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご質問、アイデア、不具合の報告は、ウェブサイトのメッセージフォームへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문, 아이디어, 버그 신고: 웹사이트의 메시지 양식을 이용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klausimai, idėjos, pranešimai apie klaidas: žinučių forma svetainėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jautājumi, idejas, ziņojumi par kļūdām: ziņas veidlapa tīmekļa vietnē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistoqsijiet, ideat, rapporti ta' bugs: il-formola tal-messaġġi fuq is-sit web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen, ideeën, foutmeldingen: het berichtformulier op de website."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania, pomysły, zgłoszenia błędów: formularz kontaktowy na stronie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvidas, ideias, relatos de bugs: o formulário de mensagem no site."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas, ideias, erros encontrados: o formulário de mensagem no site."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebări, idei, raportări de erori: formularul de mesaje de pe site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы, идеи, сообщения об ошибках — форма обратной связи на сайте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otázky, nápady, hlásenia chýb: formulár na odoslanie správy na webovej stránke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašanja, ideje, prijave napak: obrazec za sporočila na spletnem mestu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågor, idéer, felrapporter: meddelandeformuläret på webbplatsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorular, fikirler, hata bildirimleri: web sitesindeki mesaj formu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi, ý tưởng, báo lỗi: biểu mẫu tin nhắn trên trang web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题、想法、错误报告：请使用网站上的留言表单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問題、想法、錯誤回報：請使用網站上的訊息表單。"
          }
        }
      }
    },
    "help.free": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Завинаги безплатно · лиценз MIT · отворен код · без телеметрия"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navždy zdarma · licence MIT · open source · bez telemetrie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for altid · MIT-licens · open source · ingen telemetri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer kostenlos · MIT-Lizenz · Open Source · keine Telemetrie"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν για πάντα · άδεια MIT · ανοιχτός κώδικας · χωρίς τηλεμετρία"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free forever · MIT licence · open source · no telemetry"
          }
        },
        "es": {
