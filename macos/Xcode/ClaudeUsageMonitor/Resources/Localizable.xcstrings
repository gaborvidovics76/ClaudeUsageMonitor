            "value": "Strežnik omejuje število zahtev (429) – program bo samodejno poskusil znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern begränsar antalet förfrågningar (429) – försöker igen automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu istekleri sınırlıyor (429) – otomatik olarak yeniden deneniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đang giới hạn tốc độ yêu cầu (429) – sẽ tự động thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
