        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng đã xuất hiện ở góc trên bên phải màn hình.\nNhấp chuột phải vào bảng hoặc biểu tượng trên thanh menu = menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板已显示在屏幕右上角。\n右键点击面板或菜单栏图标即可打开菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板已出現在螢幕右上角。\n在面板或選單列圖示上按右鍵即可開啟選單。"
          }
