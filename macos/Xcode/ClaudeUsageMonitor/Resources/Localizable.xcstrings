    "fb.sent_sub": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чета всяко съобщение. Ако има посочен имейл адрес, ще ти отговоря на него."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každou zprávu si přečtu. Je-li vyplněna e-mailová adresa, odpovím na ni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg læser hver eneste besked. Har du angivet en e-mailadresse, svarer jeg dér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lese jede Nachricht. Wenn du eine E-Mail-Adresse angegeben hast, antworte ich dir per E-Mail."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζω κάθε μήνυμα. Αν αφήσατε διεύθυνση e-mail, θα απαντήσω εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I read every message. If you left an e-mail address, I'll reply there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo todos los mensajes. Si has dejado una dirección de correo, te responderé a esa dirección."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo todos los mensajes. Si dejaste un correo electrónico, te responderé ahí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loen iga sõnumi läbi. Kui jätsid e-posti aadressi, vastan sinna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luen jokaisen viestin. Jos annoit sähköpostiosoitteen, vastaan siihen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lis chaque message. Si vous avez indiqué une adresse e-mail, je vous répondrai par e-mail."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léim gach teachtaireacht. Má d'fhág tú seoladh ríomhphoist, freagróidh mé thú ar an seoladh sin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitam svaku poruku. Ako ste ostavili adresu e-pošte, odgovorit ću na nju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden üzenetet elolvasok. Ha megadtál e-mail-címet, oda válaszolok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya membaca setiap pesan. Jika Anda mencantumkan alamat email, saya akan membalas ke alamat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggo ogni messaggio. Se hai lasciato un indirizzo e-mail, ti risponderò via e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのメッセージに目を通しています。メールアドレスをご記入いただいた場合は、そちらに返信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 메시지를 읽어요. 이메일 주소를 남겼다면 그곳으로 답장할게요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaitau kiekvieną žinutę. Jei nurodėte el. pašto adresą, atsakysiu ten."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Es izlasu katru ziņu. Ja norādījāt e-pasta adresi, atbildēšu uz to."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naqra kull messaġġ. Jekk ħallejt indirizz tal-email, inwieġbek hemmhekk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik lees elk bericht. Als je een e-mailadres hebt opgegeven, antwoord ik je per e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytam każdą wiadomość. Jeśli podano adres e-mail, odpowiem na niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu leio todas as mensagens. Se você deixou um endereço de e-mail, respondo por lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leio todas as mensagens. Se deixaste um endereço de e-mail, respondo-te para esse endereço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citesc fiecare mesaj. Dacă ai lăsat o adresă de e-mail, îți răspund acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я читаю каждое сообщение. Если вы указали адрес e-mail, отвечу на него."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítam každú správu. Ak je v nej e-mailová adresa, odpoviem na ňu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preberem vsako sporočilo. Če ste navedli e-poštni naslov, vam bom odgovoril tja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag läser varje meddelande. Om du har lämnat en e-postadress svarar jag dit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her mesajı okuyorum. E-posta adresinizi bıraktıysanız o adrese yanıt vereceğim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đọc mọi tin nhắn. Nếu bạn để lại địa chỉ email, tôi sẽ trả lời qua đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一条留言我都会读。如果你留了邮箱，我会通过邮件回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一則訊息我都會親自閱讀。如果你留下了電子郵件地址，我會寄信回覆你。"
          }
        }
      }
    },
