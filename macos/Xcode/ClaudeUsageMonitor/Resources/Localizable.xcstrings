    "set.color_hint": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветовете се сменят според праговете: зелено → жълто → червено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barvy se mění podle prahů: zelená → žlutá → červená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farverne skifter med tærsklerne: grøn → gul → rød."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farben ändern sich mit den Schwellen: grün → gelb → rot."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα χρώματα αλλάζουν με τα κατώφλια: πράσινο → κίτρινο → κόκκινο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors change with the thresholds: green → yellow → red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores cambian con los umbrales: verde → amarillo → rojo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores cambian según los umbrales: verde → amarillo → rojo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värvid muutuvad lävendite järgi: roheline → kollane → punane."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värit vaihtuvat kynnysarvojen mukaan: vihreä → keltainen → punainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs changent selon les seuils : vert → jaune → rouge."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athraíonn na dathanna de réir na dtairseach: glas → buí → dearg."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boje se mijenjaju prema pragovima: zelena → žuta → crvena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színek a küszöbök szerint váltanak: zöld → sárga → piros."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna berubah sesuai ambang batas: hijau → kuning → merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori cambiano con le soglie: verde → giallo → rosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色はしきい値に応じて変わります: 緑 → 黄 → 赤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상은 임계값에 따라 바뀌어요: 녹색 → 노란색 → 빨간색."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalvos keičiasi pagal ribas: žalia → geltona → raudona."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krāsas mainās atkarībā no sliekšņiem: zaļa → dzeltena → sarkana."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kuluri jinbidlu skont il-livelli: aħdar → isfar → aħmar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleuren veranderen met de drempels: groen → geel → rood."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory zmieniają się z progami: zielony → żółty → czerwony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores mudam conforme os limiares: verde → amarelo → vermelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores mudam com os limiares: verde → amarelo → vermelho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culorile se schimbă în funcție de praguri: verde → galben → roșu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета меняются по порогам: зелёный → жёлтый → красный."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Farby sa menia podľa prahov: zelená → žltá → červená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Barve se spreminjajo glede na prage: zelena → rumena → rdeča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgerna ändras vid tröskelvärdena: grön → gul → röd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkler eşiklerle değişir: yeşil → sarı → kırmızı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu thay đổi theo ngưỡng: xanh lục → vàng → đỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色随阈值变化：绿色 → 黄色 → 红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩會隨門檻變化：綠色 → 黃色 → 紅色。"
          }
        }
      }
    },
