          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenettel együtt elmegy: a program verziója ({0}), az operációs rendszer ({1}), a felület nyelve ({2})."
          }
        },
        "id": {
          "stringUnit": {
