    "set.demo_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demodaten: erzeugte Beispielwerte, damit das Panel ohne Claude-Konto und ohne die Claude-Desktop-App ausprobiert werden kann. Es wird nichts geladen oder gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo data: generated sample figures, so the panel can be tried without a Claude account or the Claude desktop app. Nothing is fetched or sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de démo : des valeurs d'exemple générées, pour essayer le panneau sans compte Claude ni l'app Claude Desktop. Rien n'est téléchargé ni envoyé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Demóadatok: generált mintaszámok, hogy a panel Claude-fiók és Claude asztali app nélkül is kipróbálható legyen. Semmi nem töltődik le és nem megy el sehova."
          }
        }
      }
    },
    "set.details_api_only": {
