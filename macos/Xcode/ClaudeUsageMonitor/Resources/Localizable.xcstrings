    "set.claude_code_hint_mac": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS führt diese App in einer Sandbox aus: Wähle einmal den Ordner von Claude Code (~/.claude), damit die App seine Protokolle lesen darf. Sonst wird nichts auf der Festplatte angefasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS keeps this app in a sandbox: choose Claude Code's folder (~/.claude) once, so the app may read its logs. Nothing else on your disk is touched."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exécute cette app dans un bac à sable : choisissez une fois le dossier de Claude Code (~/.claude) pour que l'app puisse lire ses journaux. Rien d'autre n'est touché."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS homokozóban futtatja ezt az appot: válaszd ki egyszer a Claude Code mappáját (~/.claude), hogy az app olvashassa a naplóit. A lemez többi részéhez nem nyúl."
          }
        }
      }
    },
