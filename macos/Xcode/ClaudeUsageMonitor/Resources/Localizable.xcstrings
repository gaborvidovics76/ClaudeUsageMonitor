    "fb.message_ph": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво работи, какво не, какво липсва?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co funguje, co ne, co chybí?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad virker, hvad virker ikke, hvad mangler?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was funktioniert, was nicht, was fehlt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι λειτουργεί, τι όχι, τι λείπει;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What works, what doesn't, what's missing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué funciona, qué no y qué falta?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué funciona, qué no y qué falta?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis töötab, mis mitte, mis puudub?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä toimii, mikä ei, mitä puuttuu?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui fonctionne, qu'est-ce qui ne fonctionne pas, qu'est-ce qui manque ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cad a oibríonn, cad nach n-oibríonn, cad atá in easnamh?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što radi, što ne radi, što nedostaje?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi működik, mi nem, mi hiányzik?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang berfungsi, apa yang tidak, apa yang kurang?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa funziona, cosa no, cosa manca?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまく動く点、動かない点、足りない点は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 되는 것, 안 되는 것, 아쉬운 것은 무엇인가요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas veikia, kas ne, ko trūksta?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas darbojas, kas nedarbojas, kā trūkst?"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "X'jaħdem, x'ma jaħdimx, x'inhu nieqes?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat werkt, wat niet, wat ontbreekt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co działa, co nie działa, czego brakuje?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que funciona, o que não funciona, o que está faltando?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que funciona, o que não funciona, o que falta?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce funcționează, ce nu, ce lipsește?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что работает, что нет, чего не хватает?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo funguje, čo nie a čo chýba?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj deluje, kaj ne in kaj manjka?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad fungerar, vad fungerar inte, vad saknas?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne çalışıyor, ne çalışmıyor, ne eksik?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì ổn, điều gì chưa ổn, còn thiếu gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些好用，哪些不好用，还缺什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些功能好用、哪些不好用、還缺什麼？"
          }
        }
      }
    },
    "fb.meta": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заедно със съобщението се изпращат: версията на програмата {0}, операционната система ({1}) и езикът на интерфейса ({2})."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spolu se zprávou se odešle: verze programu {0}, operační systém ({1}), jazyk rozhraní ({2})."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendes sammen med beskeden: programversion {0}, operativsystem ({1}), sprog i brugerfladen ({2})."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Nachricht werden gesendet: Programmversion {0}, Betriebssystem ({1}), Sprache der Oberfläche ({2})."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαζί με το μήνυμα αποστέλλονται: η έκδοση της εφαρμογής {0}, το λειτουργικό σύστημα ({1}), η γλώσσα του περιβάλλοντος ({2})."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent along with the message: program version {0}, operating system ({1}), interface language ({2})."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto con el mensaje se envían: la versión del programa ({0}), el sistema operativo ({1}) y el idioma de la interfaz ({2})."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto con el mensaje se envían: la versión del programa ({0}), el sistema operativo ({1}) y el idioma de la interfaz ({2})."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koos sõnumiga saadetakse: programmi versioon {0}, operatsioonisüsteem ({1}), kasutajaliidese keel ({2})."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestin mukana lähetetään: ohjelman versio {0}, käyttöjärjestelmä ({1}) ja käyttöliittymän kieli ({2})."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyés avec le message : la version du programme ({0}), le système d'exploitation ({1}) et la langue de l'interface ({2})."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seoltar leis an teachtaireacht: leagan an chláir {0}, an córas oibriúcháin ({1}), teanga an chomhéadain ({2})."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
