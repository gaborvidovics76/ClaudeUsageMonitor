    "dlg.err_badcode": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодът не беше приет.\n\n{}\n\nПровери дали е поставен целият код или опитай отново да влезеш през браузъра (всеки път с нов код)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód nebyl přijat.\n\n{}\n\nZkontrolujte, zda jste vložili celý kód, nebo zkuste přihlášení v prohlížeči znovu (vždy čerstvý kód)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden blev ikke accepteret.\n\n{}\n\nTjek, at du har indsat hele koden, eller prøv at logge på i browseren igen (altid med en ny kode)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code wurde nicht akzeptiert.\n\n{}\n\nPrüfe, ob du den ganzen Code eingefügt hast, oder versuche die Browser-Anmeldung erneut (immer ein frischer Code)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός δεν έγινε δεκτός.\n\n{}\n\nΒεβαιωθείτε ότι επικολλήσατε ολόκληρο τον κωδικό ή δοκιμάστε ξανά την είσοδο μέσω του προγράμματος περιήγησης (πάντα με νέο κωδικό)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code was not accepted.\n\n{}\n\nCheck that you pasted the whole code, or try the browser sign-in again (always a fresh code)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no se ha aceptado.\n\n{}\n\nComprueba que has pegado el código completo o vuelve a iniciar sesión en el navegador (siempre con un código nuevo)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no fue aceptado.\n\n{}\n\nRevisa que hayas pegado el código completo o vuelve a iniciar sesión en el navegador (siempre con un código nuevo)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ei aktsepteeritud.\n\n{}\n\nKontrolli, kas kleepisid kogu koodi, või proovi brauseris uuesti sisse logida (iga kord on vaja uut koodi)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodia ei hyväksytty.\n\n{}\n\nVarmista, että liitit koko koodin, tai kirjaudu uudelleen selaimessa (tarvitset aina uuden koodin)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code n'a pas été accepté.\n\n{}\n\nVérifie que tu as collé le code entier, ou relance la connexion navigateur (toujours un code frais)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor glacadh leis an gcód.\n\n{}\n\nDeimhnigh gur ghreamaigh tú an cód ar fad, nó bain triail eile as an síniú isteach sa bhrabhsálaí (cód úr gach uair)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd nije prihvaćen.\n\n{}\n\nProvjerite jeste li zalijepili cijeli kôd ili se ponovno prijavite u pregledniku (svaki put je potreban novi kôd)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód nem fogadható el.\n\n{}\n\nEllenőrizd, hogy a teljes kódot másoltad-e be, vagy próbáld újra a böngészős bejelentkezést (mindig friss kód kell)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode tidak diterima.\n\n{}\n\nPastikan Anda menempelkan seluruh kode, atau coba masuk lagi lewat browser (selalu dengan kode baru)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice non è stato accettato.\n\n{}\n\nVerifica di aver incollato tutto il codice, oppure riprova l'accesso dal browser (sempre un codice nuovo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが受け付けられませんでした。\n\n{}\n\nコードをすべて貼り付けたか確認するか、ブラウザーでもう一度サインインしてください（その都度、新しいコードが発行されます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 승인되지 않았어요.\n\n{}\n\n코드 전체를 붙여넣었는지 확인하거나, 브라우저 로그인을 다시 시도해 보세요(항상 새 코드가 필요해요)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas nepriimtas.\n\n{}\n\nPatikrinkite, ar įklijavote visą kodą, arba dar kartą prisijunkite per naršyklę (kodas kaskart naujas)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kods netika pieņemts.\n\n{}\n\nPārbaudiet, vai ielīmējāt visu kodu, vai arī vēlreiz pierakstieties pārlūkprogrammā (katru reizi ir vajadzīgs jauns kods)."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-kodiċi ma ġiex aċċettat.\n\n{}\n\nIċċekkja li waħħalt il-kodiċi kollu, jew erġa' pprova l-login mill-browser (dejjem b'kodiċi ġdid)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code werd niet geaccepteerd.\n\n{}\n\nControleer of je de hele code hebt geplakt, of probeer de browser-aanmelding opnieuw (altijd een verse code)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod nie został zaakceptowany.\n\n{}\n\nSprawdź, czy wkleiłeś cały kod, lub spróbuj logowania w przeglądarce ponownie (zawsze świeży kod)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código não foi aceito.\n\n{}\n\nVerifique se você colou o código inteiro ou tente fazer login de novo pelo navegador (sempre com um código novo)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O código não foi aceite.\n\n{}\n\nVerifica se colaste o código completo ou repete o início de sessão no browser (é sempre preciso um código novo)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul nu a fost acceptat.\n\n{}\n\nVerifică dacă ai lipit codul complet sau încearcă din nou conectarea din browser (de fiecare dată cu un cod nou)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код не принят.\n\n{}\n\nПроверьте, что вставили код целиком, или повторите вход через браузер (всегда свежий код)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód nebol prijatý.\n\n{}\n\nSkontroluj, či je vložený celý kód, alebo sa skús znova prihlásiť v prehliadači (vždy s novým kódom)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda ni bila sprejeta.\n\n{}\n\nPreverite, ali ste prilepili celotno kodo, ali pa se znova prijavite v brskalniku (vsakič z novo kodo)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden godkändes inte.\n\n{}\n\nKontrollera att du klistrade in hela koden, eller logga in via webbläsaren igen (du får alltid en ny kod)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kabul edilmedi.\n\n{}\n\nKodun tamamını yapıştırdığından emin ol ya da tarayıcı girişini tekrar dene (her zaman taze kod)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã không được chấp nhận.\n\n{}\n\nHãy kiểm tra xem bạn đã dán toàn bộ mã chưa, hoặc thử đăng nhập lại qua trình duyệt (luôn dùng mã mới)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码未被接受。\n\n{}\n\n请检查是否粘贴了完整的代码，或重新在浏览器中登录（每次都会生成新代码）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權碼驗證失敗。\n\n{}\n\n請確認已貼上完整的授權碼，或重新在瀏覽器中登入（每次都會取得新的授權碼）。"
          }
        }
      }
    },
    "dlg.err_ratelimit": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Твърде много опити за влизане за кратко време.\n\nСървърът временно ограничава достъпа ти. Затвори този прозорец, изчакай 10–15 минути (без да опитваш междувременно) и след това започни ЕДНО ново влизане през браузъра с нов код."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pokusů o přihlášení v krátké době.\n\nServer vás dočasně omezuje. Zavřete toto okno, počkejte 10–15 minut (mezitím to nezkoušejte) a pak spusťte JEDNO nové přihlášení v prohlížeči s čerstvým kódem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange loginforsøg på kort tid.\n\nServeren begrænser dig midlertidigt. Luk dette vindue, vent 10–15 minutter (uden at prøve imens), og start derefter ÉT nyt login i browseren med en ny kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche in kurzer Zeit.\n\nDer Server begrenzt dich vorübergehend. Schließe dieses Fenster, warte 10–15 Minuten (versuche es zwischendurch nicht), und starte dann EINE neue Browser-Anmeldung mit einem frischen Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές προσπάθειες εισόδου σε σύντομο χρόνο.\n\nΟ διακομιστής σάς περιορίζει προσωρινά. Κλείστε αυτό το παράθυρο, περιμένετε 10–15 λεπτά (χωρίς να δοκιμάσετε στο μεταξύ) και έπειτα ξεκινήστε ΜΙΑ νέα είσοδο μέσω του προγράμματος περιήγησης με νέο κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts in a short time.\n\nThe server is limiting you temporarily. Close this window, wait 10–15 minutes (don't try in the meantime), then start ONE new browser sign-in with a fresh code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión en poco tiempo.\n\nEl servidor ha bloqueado los intentos temporalmente. Cierra esta ventana, espera entre 10 y 15 minutos (no lo intentes mientras tanto) y luego vuelve a iniciar sesión en el navegador UNA sola vez, con un código nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión en poco tiempo.\n\nEl servidor te está limitando temporalmente. Cierra esta ventana, espera de 10 a 15 minutos (no lo intentes mientras tanto) y luego vuelve a iniciar sesión en el navegador UNA sola vez, con un código nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiga palju sisselogimiskatseid lühikese aja jooksul.\n\nServer piirab sind ajutiselt. Sule see aken, oota 10–15 minutit (vahepeal ära proovi) ja proovi siis brauseris värske koodiga ÜKS kord uuesti sisse logida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta kirjautumisyritystä lyhyessä ajassa.\n\nPalvelin rajoittaa yrityksiäsi tilapäisesti. Sulje tämä ikkuna, odota 10–15 minuuttia (älä yritä sillä välin) ja aloita sitten YKSI uusi kirjautuminen selaimessa uudella koodilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de connexion en peu de temps.\n\nLe serveur te limite temporairement. Ferme cette fenêtre, attends 10–15 minutes (n'essaie pas entre-temps), puis lance UNE seule nouvelle connexion navigateur avec un code frais."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An iomarca iarrachtaí síniú isteach in achar gearr.\n\nTá an freastalaí ag cur sriain ort go sealadach. Dún an fhuinneog seo, fan 10–15 nóiméad (ná bain triail as idir an dá linn), ansin tosaigh AON síniú isteach nua amháin sa bhrabhsálaí le cód úr."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave u kratkom vremenu.\n\nPoslužitelj vam je privremeno ograničio pristup.Zatvorite ovaj prozor, pričekajte 10–15 minuta (u međuvremenu ne pokušavajte), a zatim pokrenite JEDNU novu prijavu u pregledniku s novim kôdom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok bejelentkezési próbálkozás rövid idő alatt.\n\nA szerver átmenetileg korlátoz. Zárd be ezt az ablakot, várj 10–15 percet (ne próbálkozz közben), majd indíts EGYETLEN új böngészős bejelentkezést friss kóddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak upaya masuk dalam waktu singkat.\n\nServer membatasi Anda untuk sementara. Tutup jendela ini, tunggu 10–15 menit (jangan mencoba lagi selama menunggu), lalu mulai SATU proses masuk baru lewat browser dengan kode baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di accesso in poco tempo.\n\nIl server ti limita temporaneamente. Chiudi questa finestra, attendi 10–15 minuti (non riprovare nel frattempo), poi avvia UN solo nuovo accesso dal browser con un codice nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間でのサインインの試行回数が多すぎます。\n\nサーバーが一時的にアクセスを制限しています。このウィンドウを閉じて10～15分待ち（その間は再試行しないでください）、新しいコードでブラウザーからのサインインを1回だけ行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 시간에 로그인 시도가 너무 많았어요.\n\n서버가 일시적으로 제한하고 있어요. 이 창을 닫고 10–15분 기다린 뒤(그동안은 시도하지 마세요) 새 코드로 브라우저 로그인을 한 번만 다시 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trumpą laiką per daug bandymų prisijungti.\n\nServeris laikinai apribojo prisijungimą. Uždarykite šį langą, palaukite 10–15 minučių (tuo metu nebandykite), tada pradėkite VIENĄ naują prisijungimą per naršyklę su nauju kodu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk daudz pierakstīšanās mēģinājumu īsā laikā.\n\nServeris uz laiku ierobežo jūsu piekļuvi. Aizveriet šo logu, pagaidiet 10–15 minūtes (pa to laiku nemēģiniet) un pēc tam sāciet VIENU jaunu pierakstīšanos pārlūkprogrammā ar jaunu kodu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisq tentattivi ta' login fi ftit ħin.\n\nIs-server qed jillimitak b'mod temporanju. Agħlaq din it-tieqa, stenna 10–15-il minuta (tippruvax sadanittant), imbagħad ibda login ġdid WIEĦED biss mill-browser b'kodiċi ġdid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel aanmeldpogingen in korte tijd.\n\nDe server beperkt je tijdelijk. Sluit dit venster, wacht 10–15 minuten (probeer ondertussen niet), en start dan ÉÉN nieuwe browser-aanmelding met een verse code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób logowania w krótkim czasie.\n\nSerwer tymczasowo Cię ogranicza. Zamknij to okno, odczekaj 10–15 minut (nie próbuj w tym czasie), a potem uruchom JEDNO nowe logowanie w przeglądarce ze świeżym kodem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas de login em pouco tempo.\n\nO servidor está limitando você temporariamente. Feche esta janela, aguarde 10–15 minutos (sem tentar nesse meio-tempo) e só então faça UM novo login pelo navegador, com um código novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas de início de sessão em pouco tempo.\n\nO servidor está a limitar-te temporariamente. Fecha esta janela, espera 10–15 minutos (sem tentar entretanto) e depois inicia sessão no browser UMA só vez, com um código novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de conectare într-un timp scurt.\n\nServerul te limitează temporar. Închide această fereastră, așteaptă 10–15 minute (nu încerca între timp), apoi pornește O SINGURĂ conectare nouă din browser, cu un cod nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток входа за короткое время.\n\nСервер временно ограничивает вас. Закройте это окно, подождите 10–15 минут (не пытайтесь в это время), затем выполните ОДИН новый вход через браузер со свежим кодом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov o prihlásenie v krátkom čase.\n\nServer ťa dočasne obmedzuje. Zavri toto okno, počkaj 10–15 minút (medzitým to neskúšaj) a potom spusti JEDNO nové prihlásenie v prehliadači s novým kódom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveč poskusov prijave v kratkem času.\n\nStrežnik vas začasno omejuje. Zaprite to okno, počakajte 10–15 minut (vmes ne poskušajte), nato pa začnite ENO novo prijavo v brskalniku z novo kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många inloggningsförsök på kort tid.\n\nServern begränsar dig tillfälligt. Stäng det här fönstret, vänta 10–15 minuter (försök inte under tiden) och starta sedan EN ny inloggning i webbläsaren med en ny kod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa sürede çok fazla giriş denemesi.\n\nSunucu geçici olarak sınırlıyor. Bu pencereyi kapat, 10–15 dakika bekle (bu sırada deneme), sonra taze bir kodla TEK bir yeni tarayıcı girişi başlat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều lần thử đăng nhập trong thời gian ngắn.\n\nMáy chủ đang tạm thời giới hạn bạn. Hãy đóng cửa sổ này, chờ 10–15 phút (đừng thử trong lúc đó), rồi bắt đầu MỘT lần đăng nhập mới qua trình duyệt với mã mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时间内登录尝试次数过多。\n\n服务器已暂时限制你的请求。请关闭此窗口，等待 10–15 分钟（期间不要再尝试），然后只发起一次新的浏览器登录，并使用新代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間內登入嘗試次數過多。\n\n伺服器暫時限制了你的請求。請關閉此視窗，等待 10～15 分鐘（期間不要再嘗試），然後只在瀏覽器中重新登入一次，並使用新的授權碼。"
          }
        }
      }
    },
    "dlg.hint1": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влез на страницата, която ще се отвори, и разреши достъпа. Накрая ще получиш код."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se na otevřené stránce a povolte přístup. Na konci dostanete kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log på den side, der åbnes, og godkend adgangen. Til sidst får du en kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf der geöffneten Seite an und erlaube den Zugriff. Am Ende erhältst du einen Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στη σελίδα που ανοίγει και εγκρίνετε την πρόσβαση. Στο τέλος θα λάβετε έναν κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in on the page that opens and approve access. You'll get a code at the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la página que se abre y autoriza el acceso. Al final recibirás un código."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la página que se abre y autoriza el acceso. Al final recibirás un código."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logi avanenud lehel sisse ja kinnita juurdepääs. Lõpus saad koodi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään avautuvalla sivulla ja hyväksy käyttöoikeus. Lopuksi saat koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi sur la page qui s'ouvre et autorise l'accès. Tu obtiens un code à la fin."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sínigh isteach ar an leathanach a osclóidh, agus ceadaigh rochtain. Gheobhaidh tú cód ag an deireadh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na stranici koja se otvori i odobrite pristup. Na kraju ćete dobiti kôd."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megnyíló oldalon lépj be és engedélyezd a hozzáférést. A végén kapsz egy kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk di halaman yang terbuka dan setujui aksesnya. Di akhir, Anda akan mendapat kode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi nella pagina che si apre e autorizza l'accesso. Alla fine ricevi un codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたページでサインインし、アクセスを許可してください。最後にコードが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열리는 페이지에서 로그인하고 접근을 허용하세요. 마지막에 코드를 받게 돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsidariusiame puslapyje prisijunkite ir suteikite prieigą. Pabaigoje gausite kodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atvērtajā lapā pierakstieties un atļaujiet piekļuvi. Beigās saņemsiet kodu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Idħol fil-paġna li tinfetaħ u approva l-aċċess. Fl-aħħar tirċievi kodiċi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan op de geopende pagina en keur toegang goed. Aan het eind krijg je een code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na otwartej stronie i zatwierdź dostęp. Na końcu otrzymasz kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login na página que abrir e autorize o acesso. No final, você vai receber um código."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão na página que se abre e autoriza o acesso. No fim recebes um código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te pe pagina care se deschide și aprobă accesul. La final vei primi un cod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите на открывшейся странице и разрешите доступ. В конце вы получите код."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stránke, ktorá sa otvorí, sa prihlás a schváľ prístup. Na konci dostaneš kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na strani, ki se odpre, se prijavite in odobrite dostop. Na koncu boste prejeli kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på sidan som öppnas och godkänn åtkomsten. Till sist får du en kod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılan sayfada giriş yap ve erişimi onayla. Sonunda bir kod alırsın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập trên trang vừa mở và cho phép truy cập. Cuối cùng bạn sẽ nhận được một mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打开的页面中登录并授权访问。完成后你会获得一个代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開啟的頁面登入並允許存取，最後你會收到一組授權碼。"
          }
        }
      }
    },
    "dlg.intro": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влез в акаунта си в claude.ai от собствения си браузър (там вече работят запазените ти пароли и ключове за достъп)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se ke svému účtu claude.ai ve svém prohlížeči (uložená hesla a passkeye tam už fungují)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log på din claude.ai-konto i din egen browser (dine gemte adgangskoder og adgangsnøgler virker allerede der)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in deinem Browser bei claude.ai an (deine gespeicherten Passwörter und Passkeys funktionieren dort bereits)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στον λογαριασμό σας στο claude.ai από το δικό σας πρόγραμμα περιήγησης (οι αποθηκευμένοι κωδικοί πρόσβασης και τα κλειδιά πρόσβασης λειτουργούν ήδη εκεί)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your claude.ai account in your own browser (your saved passwords and passkeys already work there)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de claude.ai desde tu propio navegador (allí ya funcionan tus contraseñas y claves de acceso guardadas)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de claude.ai en tu propio navegador (ahí ya funcionan tus contraseñas y llaves de acceso guardadas)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logi oma brauseris claude.ai kontole sisse (sinu salvestatud paroolid ja pääsuvõtmed töötavad seal juba)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu claude.ai-tiliisi omassa selaimessasi (tallennetut salasanasi ja pääsyavaimesi toimivat siellä jo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à ton compte claude.ai dans ton navigateur (tes mots de passe et passkeys enregistrés y fonctionnent déjà)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sínigh isteach i do chuntas claude.ai i do bhrabhsálaí féin (oibríonn do phasfhocail agus d'eochracha rochtana sábháilte ansin cheana féin)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na svoj račun claude.ai u vlastitom pregledniku (u njemu su vam već dostupne spremljene lozinke i pristupni ključevi)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejelentkezés a claude.ai-fiókodba a saját böngésződben (ott a jelszavaid és passkey-d már működnek)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke akun claude.ai Anda di browser sendiri (kata sandi dan kunci sandi yang tersimpan di sana langsung bisa dipakai)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi al tuo account claude.ai nel tuo browser (le password e le passkey salvate funzionano già lì)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのブラウザーで claude.ai アカウントにサインインします（保存済みのパスワードやパスキーがそのまま使えます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 브라우저에서 claude.ai 계정에 로그인하세요(저장된 비밀번호와 패스키를 그대로 쓸 수 있어요)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite prie claude.ai paskyros savo naršyklėje (ten jau veikia jūsų išsaugoti slaptažodžiai ir prieigos raktai)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstieties savā claude.ai kontā, izmantojot savu pārlūkprogrammu (tajā jau darbojas jūsu saglabātās paroles un piekļuves atslēgas)."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Idħol fil-kont tiegħek ta' claude.ai fil-browser tiegħek stess (il-passwords u l-passkeys salvati tiegħek diġà jaħdmu hemm)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan bij je claude.ai-account in je eigen browser (je opgeslagen wachtwoorden en passkeys werken daar al)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do konta claude.ai w swojej przeglądarce (zapisane hasła i passkeye już tam działają)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na sua conta do claude.ai no seu próprio navegador (suas senhas e chaves de acesso salvas já funcionam lá)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão na tua conta do claude.ai no teu próprio browser (as palavras-passe e as chaves de acesso guardadas já funcionam lá)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la contul tău claude.ai în browserul tău (parolele și cheile de acces salvate funcționează deja acolo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в свою учётную запись claude.ai в своём браузере (сохранённые пароли и passkey там уже работают)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlás sa do svojho účtu claude.ai vo vlastnom prehliadači (uložené heslá a prístupové kľúče tam už fungujú)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se v račun claude.ai v svojem brskalniku (tam že delujejo vaša shranjena gesla in ključi za dostop)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på ditt claude.ai-konto i din egen webbläsare (där fungerar redan dina sparade lösenord och lösennycklar)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai hesabına kendi tarayıcında giriş yap (kayıtlı şifrelerin ve passkey'lerin orada zaten çalışır)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào tài khoản claude.ai ngay trong trình duyệt của bạn (mật khẩu và khóa truy cập đã lưu ở đó vẫn dùng được)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你自己的浏览器中登录 claude.ai 账户（已保存的密码和通行密钥可直接使用）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你自己的瀏覽器中登入 claude.ai 帳戶（那裡已可使用你儲存的密碼與密碼金鑰）。"
          }
        }
      }
    },
