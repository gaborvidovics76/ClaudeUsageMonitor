        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt đặt lại giới hạn đã lưu của bạn sẽ hết hạn sau {}. Hãy dùng tại claude.ai › Cài đặt › Mức sử dụng, nếu không sẽ mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已保存的额度重置将在 {} 后到期。请在 claude.ai › 设置 › 用量 中兑换，否则将失效。"
          }
