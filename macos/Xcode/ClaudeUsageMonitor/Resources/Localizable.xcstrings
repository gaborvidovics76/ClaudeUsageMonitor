    },
    "notify.signin_needed": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влизането в claude.ai е изтекло. Кликни с десния бутон върху панела и влез отново, за да продължиш да виждаш използването от всичките си устройства."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení k claude.ai vypršelo. Klepněte pravým tlačítkem na panel a přihlaste se znovu, abyste dál viděli využití ze všech zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login til claude.ai er udløbet. Højreklik på panelet, og log på igen for fortsat at se forbruget fra alle dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die claude.ai-Anmeldung ist abgelaufen. Rechtsklick auf das Panel und neu anmelden, um die Nutzung aller Geräte weiter zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η είσοδος στο claude.ai έληξε. Κάντε δεξί κλικ στον πίνακα και συνδεθείτε ξανά, για να συνεχίσετε να βλέπετε τη χρήση από όλες τις συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The claude.ai sign-in has expired. Right-click the panel and sign in again to keep seeing usage from all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en claude.ai ha caducado. Haz clic con el botón derecho en el panel y vuelve a iniciar sesión para seguir viendo el uso de todos tus dispositivos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de claude.ai expiró. Haz clic derecho en el panel y vuelve a iniciar sesión para seguir viendo el uso de todos tus dispositivos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai sisselogimine on aegunud. Paremklõpsa paneelil ja logi uuesti sisse, et ka edaspidi näha kõigi oma seadmete kasutust."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai-kirjautuminen on vanhentunut. Napsauta paneelia hiiren kakkospainikkeella ja kirjaudu uudelleen, niin näet edelleen kaikkien laitteidesi käytön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à claude.ai a expiré. Clic droit sur le panneau puis reconnectez-vous pour continuer à voir l'usage de tous vos appareils."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an síniú isteach ar claude.ai imithe in éag. Deaschliceáil ar an bpainéal agus sínigh isteach arís chun úsáid do ghléasanna go léir a fheiceáil i gcónaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava na claude.ai je istekla. Desnom tipkom kliknite panel i ponovno se prijavite kako biste i dalje vidjeli potrošnju sa svih svojih uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A claude.ai bejelentkezés lejárt. Jobb gomb a panelen, majd jelentkezz be újra, hogy továbbra is lásd az összes eszközöd használatát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk claude.ai telah kedaluwarsa. Klik kanan panel dan masuk lagi agar penggunaan dari semua perangkat Anda tetap terlihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a claude.ai è scaduto. Clic destro sul pannello e accedi di nuovo per continuare a vedere l'utilizzo di tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai のサインインの有効期限が切れました。すべてのデバイスの使用量を引き続き表示するには、パネルを右クリックしてもう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai 로그인이 만료됐어요. 모든 기기의 사용량을 계속 보려면 패널을 오른쪽 클릭하고 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungimas prie claude.ai nebegalioja. Spustelėkite skydelį dešiniuoju pelės mygtuku ir prisijunkite iš naujo, kad toliau matytumėte naudojimą visuose savo įrenginiuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu claude.ai pierakstīšanās derīgums ir beidzies. Noklikšķiniet ar peles labo pogu uz paneļa un pierakstieties vēlreiz, lai joprojām redzētu lietojumu no visām savām ierīcēm."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-login ta' claude.ai skada. Ikklikkja bil-lemin fuq il-pannell u erġa' idħol biex tkompli tara l-użu mill-apparati kollha tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De claude.ai-aanmelding is verlopen. Rechtsklik op het paneel en meld je opnieuw aan om het gebruik van al je apparaten te blijven zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie do claude.ai wygasło. Kliknij panel prawym przyciskiem i zaloguj się ponownie, aby nadal widzieć użycie ze wszystkich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no claude.ai expirou. Clique com o botão direito no painel e entre novamente para continuar vendo o uso de todos os seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão no claude.ai expirou. Clica com o botão direito no painel e inicia sessão de novo para continuares a ver a utilização de todos os teus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea la claude.ai a expirat. Dă clic dreapta pe panou și conectează-te din nou ca să vezi în continuare utilizarea de pe toate dispozitivele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в claude.ai истёк. Нажмите правой кнопкой по панели и войдите снова, чтобы видеть использование со всех устройств."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť prihlásenia na claude.ai vypršala. Klikni pravým tlačidlom na panel a znova sa prihlás, aby sa naďalej zobrazovalo využitie zo všetkých tvojich zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava v claude.ai je potekla. Z desno tipko miške kliknite ploščo in se znova prijavite, da boste še naprej videli porabo v vseh svojih napravah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen på claude.ai har gått ut. Högerklicka på panelen och logga in igen för att fortsätta se användningen från alla dina enheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai oturumu sona erdi. Panele sağ tıklayıp yeniden giriş yapın; böylece tüm cihazlarınızın kullanımını görmeye devam edersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập claude.ai đã hết hạn. Nhấp chuột phải vào bảng và đăng nhập lại để tiếp tục xem mức sử dụng từ mọi thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai 登录已过期。右键点击面板并重新登录，即可继续查看所有设备的用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai 登入已過期。請在面板上按右鍵並重新登入，才能繼續檢視所有裝置的使用量。"
          }
        }
      }
    },
