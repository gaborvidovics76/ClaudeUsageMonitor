    "help.sandbox_mac": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App läuft in Apples Sandbox: Sie liest nur die Dateien, die du in den Einstellungen ausgewählt hast (das Nutzungsprotokoll von Claude Desktop und den Ordner von Claude Code). Du kannst jederzeit eine andere Datei wählen oder die Standardwerte wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app runs in Apple's sandbox: it only reads the files you have chosen in Settings (Claude Desktop's usage log and Claude Code's folder). Choose another file at any time, or restore the defaults to forget them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app s'exécute dans le bac à sable d'Apple : elle ne lit que les fichiers choisis dans les Réglages (le journal d'utilisation de Claude Desktop et le dossier de Claude Code). Choisissez un autre fichier à tout moment, ou restaurez les réglages par défaut pour les oublier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app az Apple homokozójában fut: csak azokat a fájlokat olvassa, amelyeket a Beállításokban kiválasztottál (a Claude Desktop használati naplója és a Claude Code mappája). Bármikor választhatsz másik fájlt, vagy az alapértékek visszaállításával elfelejtheted őket."
          }
        }
      }
    },
