          "stringUnit": {
            "state": "translated",
            "value": "La connexion à claude.ai a expiré.\nReconnectez-vous : clic droit → Se connecter à claude.ai"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an síniú isteach ar claude.ai imithe in éag.\nSínigh isteach arís: deaschliceáil → Sínigh isteach ar claude.ai"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava na claude.ai je istekla.\nPonovno se prijavite: desni klik → Prijava na claude.ai"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A claude.ai bejelentkezés lejárt.\nJelentkezz be újra: jobb gomb → Bejelentkezés a claude.ai-ra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk claude.ai telah kedaluwarsa.\nMasuk lagi: klik kanan → Masuk ke claude.ai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a claude.ai è scaduto.\nAccedi di nuovo: clic destro → Accedi a claude.ai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai のサインインの有効期限が切れました。\nもう一度サインインしてください（右クリック → claude.ai にサインイン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai 로그인이 만료됐어요.\n다시 로그인하세요: 오른쪽 클릭 → claude.ai에 로그인"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungimas prie claude.ai nebegalioja.\nPrisijunkite iš naujo: dešinysis spustelėjimas → Prisijungti prie claude.ai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu claude.ai pierakstīšanās derīgums ir beidzies.\nPierakstieties vēlreiz: labā poga → Pierakstīties vietnē claude.ai"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-login ta' claude.ai skada.\nErġa' idħol: klikk bil-lemin → Idħol f'claude.ai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De claude.ai-aanmelding is verlopen.\nMeld je opnieuw aan: rechtsklik → Aanmelden bij claude.ai"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie do claude.ai wygasło.\nZaloguj się ponownie: prawy przycisk → Zaloguj do claude.ai"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no claude.ai expirou.\nEntre novamente: botão direito → Entrar no claude.ai"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão no claude.ai expirou.\nInicia sessão de novo: botão direito → Iniciar sessão no claude.ai"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea la claude.ai a expirat.\nConectează-te din nou: clic dreapta → Conectare la claude.ai"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в claude.ai истёк.\nВойдите снова: правый клик → Войти в claude.ai"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť prihlásenia na claude.ai vypršala.\nPrihlás sa znova: pravé tlačidlo → Prihlásiť sa na claude.ai"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava v claude.ai je potekla.\nZnova se prijavite: desni klik → Prijava v claude.ai"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen på claude.ai har gått ut.\nLogga in igen: högerklicka → Logga in på claude.ai"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai oturumu sona erdi.\nYeniden giriş yapın: sağ tık → claude.ai'ye giriş yap"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập claude.ai đã hết hạn.\nĐăng nhập lại: nhấp chuột phải → Đăng nhập claude.ai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai 登录已过期。\n请重新登录：右键 → 登录 claude.ai"
          }
        },
        "zh-Hant": {
          "stringUnit": {
