    "err.rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сървърът ограничава заявките (429) – програмата ще опита отново автоматично."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server omezuje dotazy (429) – zkouším automaticky znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren begrænser forespørgslerne (429) – prøver automatisk igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server begrenzt die Anfragen (429) – automatischer neuer Versuch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής περιορίζει τα αιτήματα (429) – αυτόματη επανάληψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is rate limiting requests (429) – retrying automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está limitando las solicitudes (429); se volverá a intentar automáticamente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está limitando las solicitudes (429): se reintenta automáticamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Server piirab päringuid (429) – proovitakse automaatselt uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin rajoittaa pyyntöjä (429) – yritetään automaattisesti uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur limite les requêtes (429) – nouvel essai automatique."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an freastalaí ag cur teorann le hiarratais (429) – bainfear triail eile as go huathoibríoch."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
