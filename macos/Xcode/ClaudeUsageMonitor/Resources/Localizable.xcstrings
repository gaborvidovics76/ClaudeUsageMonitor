    "help.site_what": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтегляне, автоматични актуализации, какво ново, Claude Backup Kit, условия за ползване и поверителност – всичко на едно място."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování, automatické aktualizace, novinky, Claude Backup Kit, podmínky používání a ochrana soukromí – vše na jednom místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, automatiske opdateringer, nyheder, Claude Backup Kit, vilkår for brug og privatliv – alt samlet ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, automatische Updates, Neuigkeiten, das Claude Backup Kit, Nutzungsbedingungen und Datenschutz – alles an einem Ort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψεις, αυτόματες ενημερώσεις, νέα, το Claude Backup Kit, όροι χρήσης και απόρρητο – όλα σε ένα μέρος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, automatic updates, what’s new, the Claude Backup Kit, terms of use and privacy – all in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargas, actualizaciones automáticas, novedades, el Claude Backup Kit, condiciones de uso y privacidad: todo en un solo sitio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargas, actualizaciones automáticas, novedades, el Claude Backup Kit, términos de uso y privacidad: todo en un solo lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaadimised, automaatsed värskendused, väljalaskemärkmed, Claude Backup Kit, kasutustingimused ja privaatsus – kõik ühes kohas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataukset, automaattiset päivitykset, uutuudet, Claude Backup Kit, käyttöehdot ja tietosuoja – kaikki yhdessä paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements, mises à jour automatiques, nouveautés, le Claude Backup Kit, conditions d’utilisation et confidentialité – au même endroit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Íoslódálacha, nuashonruithe uathoibríocha, cad atá nua, Claude Backup Kit, téarmaí úsáide agus príobháideachas – iad uile in aon áit amháin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanja, automatska ažuriranja, novosti, Claude Backup Kit, uvjeti korištenja i privatnost – sve na jednom mjestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letöltés, automatikus frissítések, újdonságok, a Claude Backup Kit, felhasználási feltételek és adatvédelem – egy helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan, pembaruan otomatis, apa yang baru, Claude Backup Kit, ketentuan penggunaan, dan privasi – semuanya di satu tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download, aggiornamenti automatici, novità, il Claude Backup Kit, condizioni d’uso e privacy – tutto in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード、自動更新、新機能、Claude Backup Kit、利用規約、プライバシーなど、すべての情報をここにまとめています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드, 자동 업데이트, 새로운 기능, Claude Backup Kit, 이용약관과 개인정보 보호 – 모두 한곳에 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsisiuntimai, automatiniai naujinimai, naujienos, Claude Backup Kit, naudojimo sąlygos ir privatumas – viskas vienoje vietoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejupielādes, automātiskie atjauninājumi, jaunumi, Claude Backup Kit, lietošanas noteikumi un privātums – viss vienuviet."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tniżżil, aġġornamenti awtomatiċi, x'hemm ġdid, il-Claude Backup Kit, it-termini tal-użu u l-privatezza – kollox f'post wieħed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, automatische updates, nieuws, de Claude Backup Kit, gebruiksvoorwaarden en privacy – alles op één plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie, automatyczne aktualizacje, nowości, Claude Backup Kit, warunki korzystania i prywatność – wszystko w jednym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, atualizações automáticas, novidades, o Claude Backup Kit, termos de uso e privacidade – tudo em um só lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências, atualizações automáticas, novidades, o Claude Backup Kit, termos de utilização e privacidade – tudo num só lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcări, actualizări automate, noutăți, Claude Backup Kit, condițiile de utilizare și confidențialitatea – totul într-un singur loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки, автоматические обновления, новости, Claude Backup Kit, условия использования и конфиденциальность — всё в одном месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahnutie, automatické aktualizácie, novinky, Claude Backup Kit, podmienky používania a ochrana súkromia – všetko na jednom mieste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenosi, samodejne posodobitve, novosti, Claude Backup Kit, pogoji uporabe in zasebnost – vse na enem mestu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningar, automatiska uppdateringar, nyheter, Claude Backup Kit, användarvillkor och integritet – allt på ett ställe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeler, otomatik güncellemeler, yenilikler, Claude Backup Kit, kullanım koşulları ve gizlilik – hepsi tek yerde."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống, cập nhật tự động, có gì mới, Claude Backup Kit, điều khoản sử dụng và quyền riêng tư – tất cả ở một nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载、自动更新、更新内容、Claude Backup Kit、使用条款和隐私政策——全都在一个地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載、自動更新、新功能、Claude Backup Kit、使用條款與隱私權，全都在同一個地方。"
          }
        }
      }
    },
