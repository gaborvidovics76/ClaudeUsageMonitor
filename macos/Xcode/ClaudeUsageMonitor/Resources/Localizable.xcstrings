        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ограничивает запросы (429) – повтор выполняется автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server obmedzuje počet požiadaviek (429) – automaticky to skúsim znova."
          }
        },
        "sl": {
