    "err.session_expired": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесията е изтекла, влез отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace vypršela, přihlaste se znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen er udløbet. Log på igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung ist abgelaufen, melde dich erneut an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περίοδος λειτουργίας έληξε, συνδεθείτε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session has expired, sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado; vuelve a iniciar sesión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión expiró; vuelve a iniciar sesión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seanss on aegunud, logi uuesti sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istunto on vanhentunut, kirjaudu sisään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session a expiré, reconnecte-toi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an seisiún imithe in éag, sínigh isteach arís."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesija je istekla, ponovno se prijavite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkamenet lejárt, jelentkezz be újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi telah berakhir, masuk lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è scaduta, accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료됐어요. 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seansas baigėsi, prisijunkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesijas derīgums ir beidzies, pierakstieties vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-sessjoni skadiet, erġa' idħol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sessie is verlopen, meld je opnieuw aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja wygasła, zaloguj się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão expirou, entre novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão expirou, inicia sessão de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea a expirat, conectează-te din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия истекла, войдите снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť relácie vypršala, prihlás sa znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja je potekla, znova se prijavite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen har gått ut. Logga in igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum süresi doldu, tekrar giriş yap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đã hết hạn, hãy đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已过期，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已過期，請重新登入。"
          }
        }
      }
    },
