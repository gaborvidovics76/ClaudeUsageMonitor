    "set.reset_confirm": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искаш да възстановиш настройките по подразбиране?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu obnovit výchozí nastavení?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil gendanne standardindstillingerne?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du die Standardeinstellungen wirklich wiederherstellen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να επαναφέρετε τις προεπιλεγμένες ρυθμίσεις;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to restore the default settings?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres restaurar la configuración predeterminada?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres restablecer la configuración predeterminada?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas soovid kindlasti vaikesätted taastada?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti palauttaa oletusasetukset?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment restaurer les paramètres par défaut ?"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An bhfuil tú cinnte gur mian leat na réamhshocruithe a athchóiriú?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite li zaista vratiti zadane postavke?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan visszaállítod az alapértelmezett beállításokat?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin memulihkan pengaturan bawaan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero ripristinare le impostazioni predefinite?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の設定に戻してもよろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 설정으로 되돌릴까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar tikrai norite atkurti numatytuosius parametrus?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai tiešām vēlaties atjaunot noklusējuma iestatījumus?"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żgur li trid tirrestawra l-issettjar prestabbilit?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je de standaardinstellingen wilt herstellen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno przywrócić ustawienia domyślne?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja restaurar as configurações padrão?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres mesmo repor as predefinições?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur vrei să restaurezi setările implicite?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно восстановить настройки по умолчанию?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chceš obnoviť predvolené nastavenia?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali res želite obnoviti privzete nastavitve?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill återställa standardinställningarna?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan ayarları geri yüklemek istediğine emin misin?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn khôi phục cài đặt mặc định không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要恢复默认设置吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要還原預設設定嗎？"
          }
        }
      }
    },
