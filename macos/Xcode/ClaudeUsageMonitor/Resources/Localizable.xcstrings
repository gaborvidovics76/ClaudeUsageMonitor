          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server membatasi permintaan (429) – mencoba lagi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server sta limitando le richieste (429) – nuovo tentativo automatico."
          }
        },
