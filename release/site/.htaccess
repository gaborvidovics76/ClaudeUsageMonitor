# BEGIN DCB-Native protect
# A DCB-Native mentései és lágy törlései nem tölthetők le (forrás-/adatszivárgás ellen).
<FilesMatch "\.(bak|deleted|orig|tmp|log)(-[0-9]+)?$">
	Require all denied
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
# END DCB-Native protect

# Claude Usage Monitor - claudeusagemonitor.com (WEB ROOT)
#
# The site, the release files (manifest.json, versions/, macos/) and the kit are static.
# PHP may run ONLY in /usage-api/ (the backend) and /dcb-native/ (the management bridge).
# Everything else is an upload target and must never execute code.

RewriteEngine On

# 0) One canonical host: www -> bare domain (the certificate covers both; HTTPS is forced by Plesk).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 1) No script execution outside the two PHP folders (this also answers 403 for the silent /index.php).
RewriteCond %{REQUEST_URI} !^/(usage-api|dcb-native)/
RewriteRule \.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,L]

# 2) The download page is the index; the two PHP folders keep their index.php. No directory listing.
DirectoryIndex index.html index.php
Options -Indexes

# 3) Correct types.
<IfModule mod_mime.c>
    AddType application/zip .zip
    AddType application/json .json
    AddType text/markdown .md
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType application/xml .xml
    AddDefaultCharset utf-8
</IfModule>

# 4) The update client and the download page read the JSON - allow it, cache briefly.
<IfModule mod_headers.c>
    # data files are for the page and the app, not for search results
    <FilesMatch "\.json$">
        Header set X-Robots-Tag "noindex"
    </FilesMatch>
    <FilesMatch "\.(json|md)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
    <FilesMatch "\.(woff2|png|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # pages: always revalidate (cheap, ETag) so a new release or text change shows up at once
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.zip$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer"
    Header set X-Frame-Options "DENY"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # The page CSP applies to the static HTML ONLY. /usage-api/admin.php and /dcb-native/admin.php
    # send their own policy - a second, stricter header (form-action 'none') would break their forms.
    # Google hosts are listed for the OPTIONAL measurement tags (config.json). The page loads them
    # only after the visitor agrees; with no IDs configured nothing is ever requested from them.
    <FilesMatch "\.html$">
        Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://*.google.hu; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    </FilesMatch>
</IfModule>
